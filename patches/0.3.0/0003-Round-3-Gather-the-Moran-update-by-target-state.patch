-            for death in 0..3 {
-                if counts[parent] == 0 || counts[death] == 0 {
-                    continue;
+    let rows = states
+        .iter()
+        .map(|&(a, b)| {
+            let counts = [n - a - b, a, b];
+            let mut row = Vec::with_capacity(9);
+            for parent in 0..3 {
+                for death in 0..3 {
+                    if counts[parent] == 0 || counts[death] == 0 {
+                        continue;
+                    }
+                    let mut next = counts;
+                    next[parent] += 1;
+                    next[death] -= 1;
+                    row.push((
+                        index(next[1], next[2]),
+                        (counts[parent] * counts[death]) as f64 / denom,
+                    ));
