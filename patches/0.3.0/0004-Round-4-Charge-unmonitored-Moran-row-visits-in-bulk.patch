+            let expected = if max_steps >= total {
+                "complete"
+            } else {
+                "work_limit"
+            };
+            assert_eq!(row["records"][0]["status"], expected);
+            assert_eq!(row["records"][0]["steps"], max_steps.min(total));
+        }
+    }
