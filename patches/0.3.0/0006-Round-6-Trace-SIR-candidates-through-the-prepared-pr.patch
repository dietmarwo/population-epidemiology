+            + self.edges as u128 * 64
+            + n * (t * 8 + 64)
+            + t * (species * 16 + 256);
+        reserve <= u128::from(MAX_OUTPUT_BYTES)
+            && memory <= 256 * 1024 * 1024
+            && self.output_bound() <= u128::from(MAX_OUTPUT_BYTES)
+    }
